LLM_PROVIDER=google
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Build with python -m BE.scripts.ingest, then enable vector and restart BE.
RETRIEVAL_BACKEND=lexical
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
CHROMA_DIR=BE/chroma_db
CHUNK_SIZE=400
CHUNK_OVERLAP=60
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
# Hybrid uses accent-insensitive BM25 and vector retrieval with rank fusion.
# RAG_MIN_SCORE filters vector candidates; well-supported keywords can also qualify.
RETRIEVAL_HYBRID=true
RAG_SEMANTIC_ONLY_MARGIN=0.08
EMBEDDING_THREADS=4
# BE/main.py loads BE/.env on startup; values in this file override process environment.
# DATA_DIR=D:/chatbot-ptit/data
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
DIRECT_OLLAMA_CHAT=false
# MongoDB Atlas: luu tru toan bo du lieu nguon, hoi thoai, tin nhan, danh gia (feedback) va file tam (TTL 2h)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://trung09112005_db_user:kjwLNKFqq2JSp8f6@chat-bot.88dceg0.mongodb.net"
MONGODB_DB_NAME=ptit_chatbot
MONGODB_COLLECTION=source_documents
MONGODB_TEMP_COLLECTION=temp_attachments
MONGODB_CONVERSATIONS_COLLECTION=conversations
MONGODB_MESSAGES_COLLECTION=messages
MONGODB_FEEDBACK_COLLECTION=feedback
ADMIN_TOKEN=

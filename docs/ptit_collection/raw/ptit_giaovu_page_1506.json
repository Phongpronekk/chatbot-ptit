ate\">\n                                        <i class=\"fa fa-clock\"></i>\n                                    </span>\n                                    <span class=\"right date\">\n                                        <span>06/04/2026</span>\n                                    </span>\n                                </li>\n                            </ul>\n                        </div>\n                    </li>\n                            </ul>\n            \t\t\t                <!-- Pagination -->\n                    <div style=\"margin-top: 40px\"><div class='search-pagination'><span aria-current=\"page\" class=\"page-numbers current\">1</span>\n<a class=\"page-numbers\" href=\"https://giaovu.ptit.edu.vn/wp-json/wp/v2/pages/page/2/?before=2026-10-28T23%3A59%3A59&#038;per_page=100&#038;page=1\">2</a>\n<a class=\"page-numbers\" href=\"https://giaovu.ptit.edu.vn/wp-json/wp/v2/pages/page/3/?before=2026-10-28T23%3A59%3A59&#038;per_page=100&#038;page=1\">3</a>\n<span class=\"page-numbers dots\">&hellip;</span>\n<a class=\"page-numbers\" href=\"https://giaovu.ptit.edu.vn/wp-json/wp/v2/pages/page/27/?before=2026-10-28T23%3A59%3A59&#038;per_page=100&#038;page=1\">27</a>\n<a class=\"next page-numbers\" href=\"https://giaovu.ptit.edu.vn/wp-json/wp/v2/pages/page/2/?before=2026-10-28T23%3A59%3A59&#038;per_page=100&#038;page=1\"><div class=\"next-page\"><i class=\"ovaicon-next\" aria-hidden=\"true\"></i></div></a></div></div>                    \t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",

    "rendered": "Học viện Công nghệ Bưu Chính Viễn Thông phát động cuộc thi “1 vạn ý tưởng đổi mới sáng tạo”"
  },
  "content": {
    "rendered": "<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"1\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,1],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">MỤC ĐÍCH, YÊU CẦU</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"2\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Mục đích </span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"82\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Khuyến khích đoàn viên, sinh viên chủ động đề xuất các sáng kiến đổi mới trong học tập, đời sống, công nghệ và hoạt động cộng đồng; Khơi dậy tinh thần sáng tạo, khát vọng khởi nghiệp trong sinh viên.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"82\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Tìm kiếm và lan toả các ý tưởng đổi mới sáng tạo có tính thực tiễn cao, có khả năng ứng dụng công nghệ góp phần giải quyết vấn đề của xã hội và Học viện.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"82\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">Tạo môi trường rèn luyện tư duy sáng tạo, kỹ năng trình bày và bảo vệ ý tưởng cho đoàn viên, sinh viên.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"2\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Yêu cầu</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"83\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Cuộc thi được tổ chức minh bạch, sáng tạo, hiệu quả, thu hút sự tham gia rộng rãi của sinh viên.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"83\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Các ý tưởng được phát triển phải có định hướng ứng dụng thực tiễn, liên quan đến kỹ thuật – công nghệ – truyền thông hoặc đời sống sinh viên.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"1\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,1],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">ĐỊA ĐIỂM, THỜI GIAN TỔ CHỨC</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"3\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Địa điểm: </span></b><span data-contrast=\"none\">Học viện Công nghệ Bưu chính Viễn thông, </span><span data-contrast=\"none\">tất cả các cơ sở đào tạ</span><span data-contrast=\"none\">o</span><span data-contrast=\"none\">.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"3\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Thời gian dự kiến: Từ 27/05/2025 đến tháng 11/2025, cụ thể như sau:</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<table border=\"1\" data-tablestyle=\"MsoTableGrid\" data-tablelook=\"1184\" aria-rowcount=\"5\">\n<tbody>\n<tr aria-rowindex=\"1\">\n<td data-celllook=\"0\"><b><span data-contrast=\"auto\">Nội dung</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n<td data-celllook=\"0\"><b><span data-contrast=\"auto\">Thời gian</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n</tr>\n<tr aria-rowindex=\"2\">\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Phát động cuộc thi</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Từ 27/05/2025</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n</tr>\n<tr aria-rowindex=\"3\">\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Nhận ý tưởng dự thi</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n<td data-celllook=\"0\"><span data-contrast=\"auto\">27/05 – 17/09/2025</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n</tr>\n<tr aria-rowindex=\"4\">\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Chấm sơ khảo</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Tháng 10/2025</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n</tr>\n<tr aria-rowindex=\"5\">\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Chung kết &amp; trao giải</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n<td data-celllook=\"0\"><span data-contrast=\"auto\">Tháng 11/2025</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559740&quot;:288}\"> </span></td>\n</tr>\n</tbody>\n</table>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"1\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,1],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"3\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">ĐỐI TƯỢNG </span></b><b><span data-contrast=\"auto\">T</span></b><b><span data-contrast=\"auto\">HAM GIA</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"\" data-listid=\"85\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Yêu cầu: Sinh viên trong độ tuổi 18-23 học tập tại Học viện Công nghệ Bưu chính Viễn thông tại Cơ sở đào tạo </span><span data-contrast=\"auto\">tại Hà Nội và Cơ sở đào tạo tại TP. Hồ Chí Minh</span><span data-contrast=\"auto\">.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"\" data-listid=\"85\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Các sinh viên thuộc các hệ đào tạo: Đại học chính quy, hệ Vừa làm vừa học, Đại học Từ xa</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"\" data-listid=\"85\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;multilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Các Liên chi đoàn, CLB, Đội, Nhóm trực thuộc Đoàn Thanh niên Học viện Công nghệ Bưu chính Viễn thông.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"1\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,1],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"4\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">NỘI DUNG VÀ HÌNH THỨC THAM GIA</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"86\" data-list-defn-props=\"{&quot;335552541&quot;:0,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Nội dung</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"89\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Cuộc thi xoay quanh việc tìm kiếm, phát triển và lan tỏa các ý tưởng đổi mới sáng tạo trong các lĩnh vực có liên quan mật thiết đến đời sống và học tập của sinh viên Học viện, cụ thể như:</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"90\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"0\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Đổi mới trong học tập</span></b><span data-contrast=\"auto\">: Phương pháp học tập sáng tạo, công cụ hỗ trợ học hiệu quả, mô hình lớp học thông minh, nền tảng chia sẻ tri thức…</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"90\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Đời sống sinh viên</span></b><span data-contrast=\"auto\">: Ý tưởng cải thiện môi trường sống, sinh hoạt, giao tiếp, sức khỏe tinh thần và thể chất trong khuôn viên học viện.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"90\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Công nghệ và chuyển đổi số</span></b><span data-contrast=\"auto\">: Các giải pháp ứng dụng công nghệ để giải quyết vấn đề thực tiễn, chuyển đổi số trong học tập – quản trị – hoạt động sinh viên.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"90\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"3\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">H</span></b><b><span data-contrast=\"auto\">oạt động xã hộ</span></b><b><span data-contrast=\"auto\">i</span></b><span data-contrast=\"auto\">: Ý tưởng truyền thông sáng tạo, hoạt động gắn kết sinh viên, mô hình tình nguyện đổi mới, lan tỏa giá trị nhân văn.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"89\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">Mỗi ý tưởng cần thể hiện rõ:</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"91\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"0\" data-aria-level=\"1\"><span data-contrast=\"auto\">Vấn đề thực tiễn đặt ra</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"91\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">Cách tiếp cận và giải pháp đề xuất</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"91\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><span data-contrast=\"auto\">Mức độ khả thi và tác động nếu được triển khai</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"91\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"3\" data-aria-level=\"1\"><span data-contrast=\"auto\">Tính sáng tạo và khả năng ứng dụng công nghệ</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"86\" data-list-defn-props=\"{&quot;335552541&quot;:0,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,0],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Hình thức tham gia</span></b><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559740&quot;:288}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"89\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">Ban Tổ chức sẽ xây dựng và cập nhật </span><span data-contrast=\"auto\">danh sách các ý tưởng mẫu</span><span data-contrast=\"auto\"> mang tính thực tiễn, phù hợp với sinh viên, xoay quanh các chủ đề: học tập – đời sống – hoạt động</span> <span data-contrast=\"auto\">xã</span><span data-contrast=\"auto\"> hội &#8211; </span><span data-contrast=\"auto\">ứng dụng công nghệ</span><span data-contrast=\"auto\"> và chuyển đổi số</span><span data-contrast=\"auto\">.</span> <span data-contrast=\"auto\">Danh sách này được </span><span data-contrast=\"auto\">đăng tải công khai trên hệ thống quản lý cuộc thi</span> <span data-contrast=\"auto\">nhằm tạo cơ sở tham khảo, định hướng nội dung cho thí sinh có nhu cầu phát triển ý tưởng từ tình huống thực tế.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"89\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"auto\">Lựa chọn và triển khai ý tưởng:</span> <span data-contrast=\"auto\">Thí sinh có thể:</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"97\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"0\" data-aria-level=\"1\"><span data-contrast=\"auto\">Tự đề xuất</span><span data-contrast=\"auto\"> một ý tưởng hoàn toàn mới, mang dấu ấn cá nhân.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"+\" data-font=\"Times New Roman\" data-listid=\"97\" data-list-defn-props=\"{&quot;335551671&quot;:0,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;+&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><span data-contrast=\"auto\">C</span><span data-contrast=\"auto\">họn phát triển một ý tưởng mẫu</span><span data-contrast=\"auto\"> trong danh sách đã công bố, bằng cách mở rộng phạm vi, thay đổi cách tiếp cận, đề xuất phương án triển khai thực tiễn hoặc ứng dụng công nghệ phù hợp hơn.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"98\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">Hình thức nộp bài dự thi:</span> <span data-contrast=\"auto\">Bài dự thi được </span><span data-contrast=\"auto\">nộp trực tiếp trên hệ thống quản lý cuộc thi</span><span data-contrast=\"auto\"> của Ban Tổ chức.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0}\"> </span></li>\n</ul>\n<ol>\n<li data-leveltext=\"%1.\" data-font=\"\" data-listid=\"1\" data-list-defn-props=\"{&quot;134224900&quot;:true,&quot;335552541&quot;:0,&quot;335559685&quot;:644,&quot;335559991&quot;:360,&quot;469769242&quot;:[65533,1],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;%1.&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><b><span data-contrast=\"auto\">Giải thưởng:</span></b><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ol>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"94\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"5\" data-aria-level=\"1\"><span data-contrast=\"auto\">01 Giải Nhất, tiền mặt trị giá 30.000.000 đồng và quà tặng bằng hiện vật</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"94\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"6\" data-aria-level=\"1\"><span data-contrast=\"auto\">02 giải Nhì, tiền mặt trị giá 10.000.000 đồng và quà tặng bằng hiện vật</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"94\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"7\" data-aria-level=\"1\"><span data-contrast=\"auto\">03 giải Ba, tiền mặt trị giá 5.000.000 đồng và quà tặng bằng hiện vật</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n<ul>\n<li data-leveltext=\"-\" data-font=\"Times New Roman\" data-listid=\"94\" data-list-defn-props=\"{&quot;335551671&quot;:5,&quot;335552541&quot;:1,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Times New Roman&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;-&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"8\" data-aria-level=\"1\"><span data-contrast=\"auto\">Và nhiều giải thưởng phụ khác.</span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:6,&quot;335551620&quot;:6,&quot;335559685&quot;:0,&quot;335559731&quot;:284,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:276}\"> </span></li>\n</ul>\n",

    "rendered": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"1490\" class=\"elementor elementor-1490\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4d7bb0a e-flex e-con-boxed e-con e-parent\" data-id=\"4d7bb0a\" data-element_type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c3ff3ec elementor-widget elementor-widget-list-bai-viet-giaovu-3\" data-id=\"c3ff3ec\" data-element_type=\"widget\" data-widget_type=\"list-bai-viet-giaovu-3.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t  \n            <ul class=\"posts-gv posts-gv-3 column-4\">\n                                    <li class=\"item type_1\">\n                        <div class=\"media\">\n                                                        <div class=\"box-img\">\n                                <a href=\"https://giaovu.ptit.edu.vn/thong-bao-danh-sach-phan-chuyen-nganh-sinh-vien-khoa-2023-nganh-ky-thuat-dien-tu-vien-thong-khoa-2024-nganh-ky-thuat-dieu-khien-va-tu-dong-hoa-ktdt-qtkd-marketing/\" rel=\"bookmark\" title=\"Thông báo: Danh sách phân chuyên ngành sinh viên khóa 2023 ngành kỹ thuật Điện tử viễn thông, khóa 2024 ngành Kỹ thuật Điều khiển và Tự động hóa, KTĐT, QTKD, Marketing;\">\n                                    <img decoding=\"async\" src=\"https://giaovu.ptit.edu.vn/wp-content/uploads/sites/13/2025/01/TB19-300x200.png\" alt=\"Thông báo: Danh sách phân chuyên ngành sinh viên khóa 2023 ngành kỹ thuật Điện tử viễn thông, khóa 2024 ngành Kỹ thuật Điều khiển và Tự động hóa, KTĐT, QTKD, Marketing;\">\n                                </a>\n                            </div>\n                        </div> \n\n                        <div class=\"content\">\n                            <h2 class=\"post-title\">\n                                <a href=\"https://giaovu.ptit.edu.vn/thong-bao-danh-sach-phan-chuyen-nganh-sinh-vien-khoa-2023-nganh-
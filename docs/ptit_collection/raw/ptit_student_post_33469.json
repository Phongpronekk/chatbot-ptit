  "slug": "thong-bao-ve-viec-thuc-hien-danh-gia-ket-qua-ren-luyen-sinh-vien-hoc-ky-ii-nam-hoc-2025-2026-tren-he-thong-ptit-s-link",
  "status": "publish",
